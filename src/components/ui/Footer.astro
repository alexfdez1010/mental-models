---
/**
 * Footer.astro — light, simple site footer.
 * Wordmark + tagline, a compact nav, and a copyright line.
 */
import { getLangFromUrl, useTranslations, localizePath, type Lang } from '@/i18n/utils';

interface Props {
  lang?: Lang;
}

const { lang = getLangFromUrl(Astro.url) } = Astro.props;
const t = useTranslations(lang);

const year = new Date().getFullYear();

const links: { label: string; href: string }[] = [
  { label: t('nav.catalog'), href: localizePath('/catalog', lang) },
];
---

<footer class="mt-16 bg-surface">
  <div
    class="mx-auto flex max-w-6xl flex-col gap-8 px-5 py-10 sm:px-8 md:flex-row md:items-start md:justify-between"
  >
    <div class="max-w-sm">
      <a
        href={localizePath('/', lang)}
        class="flex items-center gap-2.5 font-display text-lg font-semibold tracking-tight text-ink-900"
      >
        <img
          src="/favicon.svg"
          alt=""
          aria-hidden="true"
          width="28"
          height="28"
          class="h-7 w-7 rounded-[0.55rem]"
        />
        <span>{t('brand.title')}</span>
      </a>
      <p class="mt-3 text-sm leading-relaxed text-ink-600">
        {t('footer.tagline')}
      </p>
    </div>

    <nav aria-label={t('footer.explore')} class="flex flex-wrap gap-x-6 gap-y-2 text-sm">
      {
        links.map((link) => (
          <a href={link.href} class="inline-flex min-h-11 items-center text-ink-600 transition-colors hover:text-brand-700">
            {link.label}
          </a>
        ))
      }
      <a href="https://github.com/alexfdez1010/mental-models" class="inline-flex min-h-11 items-center text-ink-600 transition-colors hover:text-brand-700">GitHub</a>
    </nav>
  </div>

  <div>
    <div class="mx-auto max-w-6xl px-5 pb-8 text-xs leading-relaxed text-ink-600 sm:px-8">
      © {year} Alejandro Fernández Camello.{' '}
      <a
        href="https://github.com/alexfdez1010/mental-models/blob/main/LICENSE"
        class="underline decoration-ink-300 underline-offset-2 transition-colors hover:text-brand-700"
        rel="license"
      >
        {t('footer.license')}
      </a>{' '}
      {t('footer.built')}
    </div>
  </div>
</footer>
